#!/usr/bin/env bash
# Inquiri (inqr) — a bash/awk log failure aggregator
# https://github.com/<you>/inqr
set -euo pipefail

PROG="inqr"
VERSION="1.0.0"

# ---------------------------------------------------------------------------
# defaults
# ---------------------------------------------------------------------------
TOP_N=10
WINDOW="15m"
SINCE=""
MODE="report"      # report | breakdown | summary
PATTERNS_FILE=""
LOGFILE=""
SPIKE_THRESHOLD=150   # percent increase over previous bucket to flag as a spike

usage() {
  cat <<'EOF'
Inquiri (inqr) — bash log failure aggregator

USAGE:
  inqr <logfile> [options]

OPTIONS:
  -t, --top N            Show top N failure types                 (default: 10)
  -w, --window SIZE      Time bucket size: 5m|15m|30m|60m|24h|day  (default: 15m)
      --since DURATION   Incident-summary mode over the trailing DURATION
                          (e.g. 30m, 24h, 7d). Implies a full report with
                          trend, new-failure detection, and spike detection.
      --breakdown        Show a per-window x per-failure-type table instead
                          of the default "Top Failures + Window Totals" report
      --patterns FILE    Extra classification rules, one per line:
                            <ERE regex><TAB><label>
                          Checked in file order, before the built-in defaults.
  -h, --help              Show this help
  -v, --version           Show version

EXAMPLES:
  inqr /var/log/app.log -t 10 -w 15m
  inqr app.log --window 1h
  inqr app.log --breakdown --window 15m
  inqr app.log --since 24h

Requires gawk (GNU awk). On Debian/Ubuntu: sudo apt install gawk
EOF
}

die() { echo "$PROG: error: $*" >&2; exit 1; }

need_gawk() {
  command -v gawk >/dev/null 2>&1 || die "gawk is required but not found. Install it with: sudo apt install gawk"
}

# ---------------------------------------------------------------------------
# arg parsing
# ---------------------------------------------------------------------------
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--top)
      TOP_N="${2:?--top needs a value}"; shift 2 ;;
    --top=*) TOP_N="${1#*=}"; shift ;;
    -w|--window)
      WINDOW="${2:?--window needs a value}"; shift 2 ;;
    --window=*) WINDOW="${1#*=}"; shift ;;
    --since)
      SINCE="${2:?--since needs a value}"; MODE="summary"; shift 2 ;;
    --since=*) SINCE="${1#*=}"; MODE="summary"; shift ;;
    --breakdown)
      MODE="breakdown"; shift ;;
    --patterns)
      PATTERNS_FILE="${2:?--patterns needs a file}"; shift 2 ;;
    --patterns=*) PATTERNS_FILE="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    -v|--version) echo "$PROG $VERSION"; exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do ARGS+=("$1"); shift; done ;;
    -*) die "unknown option: $1 (see --help)" ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

[ ${#ARGS[@]} -ge 1 ] || { usage; exit 1; }
LOGFILE="${ARGS[0]}"
[ -r "$LOGFILE" ] || die "cannot read file: $LOGFILE"

need_gawk

# ---------------------------------------------------------------------------
# resolve window alias -> seconds
# ---------------------------------------------------------------------------
window_to_seconds() {
  case "$1" in
    5m)   echo 300 ;;
    15m)  echo 900 ;;
    30m)  echo 1800 ;;
    60m|1h) echo 3600 ;;
    24h|day) echo 86400 ;;
    *)
      # allow raw forms like "45m", "2h", "3600s"
      if [[ "$1" =~ ^([0-9]+)m$ ]]; then echo $(( ${BASH_REMATCH[1]} * 60 ));
      elif [[ "$1" =~ ^([0-9]+)h$ ]]; then echo $(( ${BASH_REMATCH[1]} * 3600 ));
      elif [[ "$1" =~ ^([0-9]+)s$ ]]; then echo "${BASH_REMATCH[1]}";
      else die "invalid --window value: $1 (expected 5m|15m|30m|60m|24h|day)"; fi
      ;;
  esac
}
WINDOW_SECONDS=$(window_to_seconds "$WINDOW")

duration_to_seconds() {
  # accepts Nm, Nh, Nd
  local v="$1"
  if [[ "$v" =~ ^([0-9]+)m$ ]]; then echo $(( ${BASH_REMATCH[1]} * 60 ));
  elif [[ "$v" =~ ^([0-9]+)h$ ]]; then echo $(( ${BASH_REMATCH[1]} * 3600 ));
  elif [[ "$v" =~ ^([0-9]+)d$ ]]; then echo $(( ${BASH_REMATCH[1]} * 86400 ));
  elif [[ "$v" =~ ^([0-9]+)$ ]]; then echo "${BASH_REMATCH[1]}";
  else die "invalid duration: $v (expected e.g. 30m, 24h, 7d)"; fi
}
SINCE_SECONDS=0
[ -n "$SINCE" ] && SINCE_SECONDS=$(duration_to_seconds "$SINCE")

[[ "$TOP_N" =~ ^[0-9]+$ ]] || die "--top must be a positive integer"

# ---------------------------------------------------------------------------
# the engine — a single gawk program handling all three modes
# ---------------------------------------------------------------------------
AWK_PROGRAM='
# ---- built-in classification rules (checked in order; first match wins) ---
function load_default_patterns(   n) {
  n = 0
  n++; pat[n] = "no space left on device|disk full";        lbl[n] = "Disk full"
  n++; pat[n] = "connection refused|econnrefused";           lbl[n] = "Connection refused"
  n++; pat[n] = "permission denied|eacces";                  lbl[n] = "Permission denied"
  n++; pat[n] = "unauthorized|authentication failed|auth failed|invalid credentials"; lbl[n] = "Authentication failed"
  n++; pat[n] = "connection pool (exhausted|timeout)";       lbl[n] = "Connection pool exhausted"
  n++; pat[n] = "(could not|failed to) connect to (the )?database|database connection"; lbl[n] = "Failed to connect to database"
  n++; pat[n] = "(host|destination) unreachable|no route to host"; lbl[n] = "Host unreachable"
  n++; pat[n] = "connection reset by peer|econnreset";       lbl[n] = "Connection reset by peer"
  n++; pat[n] = "(timeout|timed out).*connect|connect.*(timeout|timed out)"; lbl[n] = "Timeout connecting"
  n++; pat[n] = "request timed? ?out|request timeout";       lbl[n] = "Request timeout"
  n++; pat[n] = "timeout|timed out";                         lbl[n] = "Timeout waiting for response"
  n++; pat[n] = "out of memory|oom";                         lbl[n] = "Out of memory"
  n++; pat[n] = "unhandled exception|uncaught exception";    lbl[n] = "Unhandled exception"
  n++; pat[n] = "ssl|tls handshake";                         lbl[n] = "TLS/SSL handshake failure"
  n_default = n
}

function load_extra_patterns(file,    line, parts, n) {
  n = 0
  if (file == "") return
  while ((getline line < file) > 0) {
    if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) continue
    split(line, parts, "\t")
    if (length(parts) < 2) continue
    n++
    xpat[n] = parts[1]; xlbl[n] = parts[2]
  }
  close(file)
  n_extra = n
}

# classify a raw log line into a canonical failure label
function classify(line,   i, low) {
  low = tolower(line)
  for (i = 1; i <= n_extra; i++)
    if (low ~ xpat[i]) return xlbl[i]
  for (i = 1; i <= n_default; i++)
    if (low ~ pat[i]) return lbl[i]
  return normalize(line)
}

# fallback normalizer: collapse variable tokens so similar lines still group
function normalize(line,   s) {
  s = line
  # drop a leading ISO-8601 timestamp, e.g. "2026-09-22 10:15:32 " / "...T...Z "
  gsub(/^[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})?[ \t]+/, "", s)
  # drop a leading syslog timestamp, e.g. "Sep 22 10:15:32 "
  gsub(/^[A-Za-z]{3}[ ]+[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2}[ \t]+/, "", s)
  # drop a leading hostname/process token typical of syslog, e.g. "myhost app[123]: "
  gsub(/^[A-Za-z0-9_.-]+ [A-Za-z0-9_.\/-]+(\[[0-9]+\])?:[ \t]+/, "", s)
  # drop a leading log-level token like ERROR: / [ERROR] / WARN -
  gsub(/^\[?[A-Za-z]+\]?[:\-][ \t]*/, "", s)
  gsub(/[0-9]{1,3}(\.[0-9]{1,3}){3}/, "<ip>", s)                       # IPv4
  gsub(/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/, "<uuid>", s)
  gsub(/"[^"]*"/, "\"...\"", s)
  gsub(/[0-9]+/, "#", s)
  gsub(/^[ \t]+|[ \t]+$/, "", s)
  if (length(s) == 0) s = "Unclassified failure"
  if (length(s) > 70) s = substr(s, 1, 67) "..."
  return s
}

# extract a unix epoch from the start of a log line; returns "" if none found
function extract_epoch(line,   m, spec, mon, mm, months, ts) {
  # ISO 8601: 2026-09-22 10:15:32  or  2026-09-22T10:15:32
  if (match(line, /^[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}/)) {
    ts = substr(line, RSTART, RLENGTH)
    gsub(/T/, " ", ts)
    split(ts, m, /[- :]/)
    spec = m[1] " " m[2] " " m[3] " " m[4] " " m[5] " " m[6]
    return mktime(spec)
  }
  # syslog: Sep 22 10:15:32  (no year -> assume current year)
  if (match(line, /^[A-Za-z]{3}[ ]+[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2}/)) {
    split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", months, " ")
    ts = substr(line, RSTART, RLENGTH)
    split(ts, m, / +/)
    mon = 0
    for (mm = 1; mm <= 12; mm++) if (months[mm] == m[1]) mon = mm
    if (mon == 0) return ""
    split(m[3], m2, ":")
    return mktime(cur_year " " mon " " m[2] " " m2[1] " " m2[2] " " m2[3])
  }
  return ""
}

function fmt_hm(epoch) { return strftime("%H:%M", epoch) }
function fmt_ymd(epoch) { return strftime("%Y-%m-%d", epoch) }
function fmt_ymdhm(epoch) { return strftime("%Y-%m-%d %H:%M", epoch) }
function bucket_start(epoch) { return epoch - (epoch % window_sec) }
function repeat(ch, n,   s, i) { s = ""; for (i = 0; i < n; i++) s = s ch; return s }

BEGIN {
  FS = "\n"
  cur_year = strftime("%Y")
  load_default_patterns()
  load_extra_patterns(patterns_file)
  failure_re = "error|fail|denied|timeout|timed out|refused|exception|unauthorized|" \
               "unreachable|disk full|no space left|panic|fatal|dropped|reset by peer|unavailable|critical"
  total_lines = 0
  first_epoch = -1
  last_epoch = -1
}

{
  total_lines++
  if (tolower($0) !~ failure_re) next

  epoch = extract_epoch($0)
  label = classify($0)

  if (epoch != "") {
    if (first_epoch == -1 || epoch < first_epoch) first_epoch = epoch
    if (last_epoch == -1 || epoch > last_epoch) last_epoch = epoch
  }

  # --since filtering happens here so counts/buckets only reflect the window
  if (since_sec > 0) {
    pending_epoch[++pending_n] = epoch
    pending_label[pending_n] = label
    pending_line[pending_n] = $0
    next
  }

  total_failures++
  by_label[label]++
  if (epoch != "") {
    b = bucket_start(epoch)
    by_bucket_total[b]++
    key = b SUBSEP label
    by_bucket_label[key]++
    seen_bucket[b] = 1
  }
}

END {
  if (since_sec > 0) {
    if (last_epoch == -1) last_epoch = systime()
    cutoff = last_epoch - since_sec
    for (i = 1; i <= pending_n; i++) {
      e = pending_epoch[i]; l = pending_label[i]
      if (e != "" && e < cutoff) continue
      total_failures++
      by_label[l]++
      if (e != "") {
        b = bucket_start(e)
        by_bucket_total[b]++
        key = b SUBSEP l
        by_bucket_label[key]++
        seen_bucket[b] = 1
        if (!(l in first_seen) || e < first_seen[l]) first_seen[l] = e
      }
    }
    period_start = cutoff
    period_end = last_epoch
  }

  n_buckets = asorti(seen_bucket, sorted_buckets, "@ind_num_asc")
  n_labels = asorti(by_label, sorted_labels_tmp)
  # sort labels by count desc (simple insertion sort; label counts are small in number)
  nl = 0
  for (l in by_label) { nl++; lab_arr[nl] = l }
  for (i = 2; i <= nl; i++) {
    key_l = lab_arr[i]; key_c = by_label[key_l]; j = i - 1
    while (j >= 1 && by_label[lab_arr[j]] < key_c) { lab_arr[j+1] = lab_arr[j]; j-- }
    lab_arr[j+1] = key_l
  }

  if (mode == "report")   { print_report();   }
  if (mode == "breakdown"){ print_breakdown();}
  if (mode == "summary")  { print_summary();  }
}

function print_top_failures(limit,   i, shown) {
  print "TOP FAILURES"
  print repeat("\xe2\x94\x80", 48)
  shown = 0
  for (i = 1; i <= nl && shown < limit; i++) {
    printf "%6d  %s\n", by_label[lab_arr[i]], lab_arr[i]
    shown++
  }
  if (nl == 0) print "  (no matching failures found)"
}

function print_report(   i, b) {
  print_top_failures(top_n)
  print ""
  print "TIME WINDOW       FAILURES"
  print repeat("\xe2\x94\x80", 30)
  if (n_buckets == 0) { print "  (no timestamped failures to bucket)"; return }
  for (i = 1; i <= n_buckets; i++) {
    b = sorted_buckets[i]
    printf "%s\xe2\x80\x93%s          %d\n", fmt_hm(b), fmt_hm(b + window_sec), by_bucket_total[b]
  }
}

function print_breakdown(   i, j, b, key, blab, nbl, tmp) {
  print "TIME             FAILURE                         COUNT"
  print repeat("\xe2\x94\x80", 56)
  if (n_buckets == 0) { print "  (no timestamped failures to bucket)"; return }
  for (i = 1; i <= n_buckets; i++) {
    b = sorted_buckets[i]
    nbl = 0
    for (key in by_bucket_label) {
      split(key, parts, SUBSEP)
      if (parts[1] == b) { nbl++; blab[nbl] = parts[2] }
    }
    for (x = 2; x <= nbl; x++) {
      kl = blab[x]; kc = by_bucket_label[b SUBSEP kl]; y = x - 1
      while (y >= 1 && by_bucket_label[b SUBSEP blab[y]] < kc) { blab[y+1] = blab[y]; y-- }
      blab[y+1] = kl
    }
    time_col = sprintf("%s-%s", fmt_hm(b), fmt_hm(b + window_sec))
    for (x = 1; x <= nbl; x++) {
      c = by_bucket_label[b SUBSEP blab[x]]
      if (x == 1) printf "%-17s%-30s %5d\n", time_col, blab[x], c
      else        printf "%-17s%-30s %5d\n", "", blab[x], c
    }
    print ""
  }
}

function print_summary(   i, b, prev, cur, pct, first_half_end) {
  print "LOG FAILURE SUMMARY"
  print repeat("\xe2\x95\x90", 46)
  printf "Period:        %s -> %s\n", fmt_ymdhm(period_start), fmt_ymdhm(period_end)
  printf "Total errors:  %d\n", total_failures
  printf "Failure types: %d\n", nl
  print ""
  print_top_failures(top_n)
  print ""
  printf "TREND — %s\n", trend_label
  print repeat("\xe2\x94\x80", 46)
  if (n_buckets == 0) print "  (no timestamped failures to bucket)"
  prev = -1
  for (i = 1; i <= n_buckets; i++) {
    b = sorted_buckets[i]; cur = by_bucket_total[b]
    marker = ""
    if (prev > 0 && cur >= prev * (spike_pct/100.0 + 1)) marker = "  <- spike"
    printf "%s   %d%s\n", fmt_hm(b), cur, marker
    prev = cur
  }
  print ""
  print "NEW FAILURES"
  print repeat("\xe2\x94\x80", 46)
  first_half_end = period_start + (period_end - period_start) / 2
  any_new = 0
  for (i = 1; i <= nl; i++) {
    l = lab_arr[i]
    if ((l in first_seen) && first_seen[l] >= first_half_end) {
      printf "%s  %s\n", fmt_hm(first_seen[l]), l
      any_new = 1
    }
  }
  if (!any_new) print "  (none — no failure type first appeared in the second half of the period)"
  print ""
  print "SPIKES"
  print repeat("\xe2\x94\x80", 46)
  any_spike = 0
  for (i = 1; i <= nl; i++) {
    l = lab_arr[i]
    prevc = -1
    for (j = 1; j <= n_buckets; j++) {
      b = sorted_buckets[j]
      c = (b SUBSEP l) in by_bucket_label ? by_bucket_label[b SUBSEP l] : 0
      if (prevc > 0 && c >= prevc * (spike_pct/100.0 + 1)) {
        pct = int(((c - prevc) / prevc) * 100)
        printf "%-24s +%d%% at %s\n", l, pct, fmt_hm(b)
        any_spike = 1
      }
      prevc = c
    }
  }
  if (!any_spike) print "  (none)"
}
'

# trend bucket label for --since mode: use the requested window (default 15m
# unless the user explicitly chose one)
TREND_LABEL="${WINDOW^^} BUCKETS"

gawk -v top_n="$TOP_N" \
     -v window_sec="$WINDOW_SECONDS" \
     -v since_sec="$SINCE_SECONDS" \
     -v mode="$MODE" \
     -v patterns_file="$PATTERNS_FILE" \
     -v spike_pct="$SPIKE_THRESHOLD" \
     -v trend_label="$TREND_LABEL" \
     "$AWK_PROGRAM" "$LOGFILE"
